<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiLesson_8_SurvivalGame.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiLesson_8_SurvivalGame"
    Title="MauiLesson_8_SurvivalGame"
    BackgroundColor="#1E1E1E"
    Shell.TabBarBackgroundColor="#121212"
    Shell.TabBarTitleColor="#4CAF50"
    Shell.TabBarUnselectedColor="#888888">

    <TabBar>
        <ShellContent
            Title="Персонаж"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Локації"
            ContentTemplate="{DataTemplate local:ExplorationPage}"
            Route="ExplorationPage" />

        <ShellContent
            Title="Інвентар"
            ContentTemplate="{DataTemplate local:InventoryPage}"
            Route="InventoryPage" />

        <ShellContent
            Title="Покращення"
            ContentTemplate="{DataTemplate local:UpgradesPage}"
            Route="UpgradesPage" />

        <ShellContent
            Title="Налаштування"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
    
    
