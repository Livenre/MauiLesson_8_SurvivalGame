<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiLesson_8_SurvivalGame.MainPage"
             Title="Головний екран — Персонаж"
             BackgroundColor="#181818">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Статус дня -->
            <Border BackgroundColor="#252525" Stroke="#3A3A3A" StrokeShape="RoundRectangle 12" Padding="15">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label x:Name="DayLabel" Text="День виживання: 1" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="WeaponStatusLabel" Text="Екіпірована зброя: Кулаки" FontSize="14" TextColor="#FFB74D" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="☀️ +22°C" FontSize="18" TextColor="#FFD54F" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Блок характеристик персонажа -->
            <Border BackgroundColor="#252525" Stroke="#3A3A3A" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Характеристики виживання" FontSize="18" FontAttributes="Bold" TextColor="White" />

                    <!-- HP -->
                    <VerticalStackLayout Spacing="3">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="❤️ Здоров'я (HP)" TextColor="#EF5350" FontAttributes="Bold" />
                            <Label Grid.Column="1" x:Name="HpLabel" Text="100 / 100" TextColor="White" />
                        </Grid>
                        <ProgressBar x:Name="HpBar" Progress="1.0" ProgressColor="#EF5350" />
                    </VerticalStackLayout>

                    <!-- Голод -->
                    <VerticalStackLayout Spacing="3">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="🍖 Ситість (Голод)" TextColor="#FFA726" FontAttributes="Bold" />
                            <Label Grid.Column="1" x:Name="HungerLabel" Text="80 / 100" TextColor="White" />
                        </Grid>
                        <ProgressBar x:Name="HungerBar" Progress="0.80" ProgressColor="#FFA726" />
                    </VerticalStackLayout>

                    <!-- Спрага -->
                    <VerticalStackLayout Spacing="3">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="💧 Гідратація (Спрага)" TextColor="#29B6F6" FontAttributes="Bold" />
                            <Label Grid.Column="1" x:Name="ThirstLabel" Text="80 / 100" TextColor="White" />
                        </Grid>
                        <ProgressBar x:Name="ThirstBar" Progress="0.80" ProgressColor="#29B6F6" />
                    </VerticalStackLayout>

                    <!-- Енергія -->
                    <VerticalStackLayout Spacing="3">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="⚡ Енергія" TextColor="#42A5F5" FontAttributes="Bold" />
                            <Label Grid.Column="1" x:Name="EnergyLabel" Text="90 / 100" TextColor="White" />
                        </Grid>
                        <ProgressBar x:Name="EnergyBar" Progress="0.90" ProgressColor="#42A5F5" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Швидкі дії -->
            <Border BackgroundColor="#252525" Stroke="#3A3A3A" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Швидкі дії виживання" FontSize="18" FontAttributes="Bold" TextColor="White" />

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                        <Button Grid.Row="0" Grid.Column="0" Text="🍖 Поїсти з рюкзака" BackgroundColor="#388E3C" TextColor="White" Clicked="OnEatClicked" />
                        <Button Grid.Row="0" Grid.Column="1" Text="💧 Попити води" BackgroundColor="#0288D1" TextColor="White" Clicked="OnDrinkClicked" />
                        <Button Grid.Row="1" Grid.Column="0" Text="💤 Поспати до ранку" BackgroundColor="#1976D2" TextColor="White" Clicked="OnRestClicked" />
                        <Button Grid.Row="1" Grid.Column="1" Text="🔥 Багаття (-2 🪵)" BackgroundColor="#F57C00" TextColor="White" Clicked="OnCampfireClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Журнал подій -->
            <Border BackgroundColor="#121212" Stroke="#2E7D32" StrokeShape="RoundRectangle 8" Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Журнал дій:" FontSize="13" TextColor="#81C784" FontAttributes="Bold" />
                    <Label x:Name="ActionLogLabel" Text="Персонаж готовий до пригод..." FontSize="14" TextColor="#E0E0E0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>