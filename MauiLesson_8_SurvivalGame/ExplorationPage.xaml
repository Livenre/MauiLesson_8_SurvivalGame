<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiLesson_8_SurvivalGame"
             x:Class="MauiLesson_8_SurvivalGame.ExplorationPage"
             Title="Дослідження та Бій"
             BackgroundColor="#181818">

    <Grid RowDefinitions="Auto, *">

        <!-- Прикріплений статичний HUD -->
        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,8" BackgroundColor="#181818">
            <local:PlayerHudView x:Name="HudView" />
        </VerticalStackLayout>

        <!-- Прокручуваний вміст -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,20" Spacing="16">

                <!-- БОЙОВА ПАНЕЛЬ (активується під час бою) -->
                <Border x:Name="CombatBorder"
                        IsVisible="False"
                        BackgroundColor="#2A1414"
                        Stroke="#E53935"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label x:Name="EnemyNameLabel" Text="Дикий ворог" FontSize="18" FontAttributes="Bold" TextColor="#FF8A80" />
                            <Label Grid.Column="1" x:Name="EnemyDamageLabel" Text="Шкода: 8-14" FontSize="13" TextColor="#FFB74D" VerticalOptions="Center" />
                        </Grid>

                        <!-- HP ворога -->
                        <VerticalStackLayout Spacing="3">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Здоров'я ворога:" TextColor="#E0E0E0" FontSize="13" />
                                <Label Grid.Column="1" x:Name="EnemyHpLabel" Text="45 / 45" TextColor="#FF8A80" FontAttributes="Bold" />
                            </Grid>
                            <ProgressBar x:Name="EnemyHpBar" Progress="1.0" ProgressColor="#E53935" HeightRequest="8" />
                        </VerticalStackLayout>

                        <!-- Кнопки бою -->
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" Margin="0,6,0,0">
                            <Button Grid.Column="0" Text="🗡️ Удар" BackgroundColor="#C62828" TextColor="White" FontAttributes="Bold" Clicked="OnAttackEnemyClicked" />
                            <Button Grid.Column="1" Text="🩹 Аптечка" BackgroundColor="#2E7D32" TextColor="White" Clicked="OnCombatHealClicked" />
                            <Button Grid.Column="2" Text="🏃 Втекти" BackgroundColor="#455A64" TextColor="White" Clicked="OnFleeClicked" />
                        </Grid>

                        <Label x:Name="CombatLogLabel" Text="Ворог приготувався до атаки! Оберіть дію." FontSize="13" TextColor="#FFE082" />
                    </VerticalStackLayout>
                </Border>

                <!-- Вибір локації та відкриття нових зон -->
                <Border BackgroundColor="#252525" Stroke="#3A3A3A" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Карта та дослідження зон" FontSize="18" FontAttributes="Bold" TextColor="White" />
                            <Label Grid.Column="1" Text="Перехід: -5⚡ -3🍖 -4💧" FontSize="12" TextColor="#FFB74D" VerticalOptions="Center" />
                        </Grid>

                        <Button x:Name="BtnCamp"
                                Text="⛺ Лісовий табір (База)"
                                BackgroundColor="#1B5E20" TextColor="White" FontAttributes="Bold"
                                Clicked="OnLocationSelected"
                                CommandParameter="Лісовий табір (База)" />

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                            <Button x:Name="BtnForest" Grid.Row="0" Grid.Column="0" Text="🌲 Густий ліс"
                                    BackgroundColor="#2E7D32" TextColor="White"
                                    Clicked="OnLocationSelected" CommandParameter="Густий ліс" />

                            <Button x:Name="BtnDesert" Grid.Row="0" Grid.Column="1" Text="🔒 Піщана пустеля"
                                    BackgroundColor="#424242" TextColor="#BDBDBD"
                                    Clicked="OnLocationSelected" CommandParameter="Піщана пустеля" />

                            <Button x:Name="BtnRuins" Grid.Row="1" Grid.Column="0" Text="🔒 Покинуті руїни"
                                    BackgroundColor="#424242" TextColor="#BDBDBD"
                                    Clicked="OnLocationSelected" CommandParameter="Покинуті руїни" />

                            <Button x:Name="BtnCave" Grid.Row="1" Grid.Column="1" Text="🔒 Гірська печера"
                                    BackgroundColor="#424242" TextColor="#BDBDBD"
                                    Clicked="OnLocationSelected" CommandParameter="Гірська печера" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Інформація про поточну локацію -->
                <Border x:Name="CurrentLocationBorder"
                        BackgroundColor="#1A261D"
                        Stroke="#2E7D32"
                        StrokeShape="RoundRectangle 12"
                        Padding="15">
                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="CurrentLocationTitle"
                               Text="Поточна локація: Лісовий табір (База)"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="#66BB6A" />
                        <Label x:Name="CurrentLocationDesc"
                               Text="Безпечне місце. Тут мало диких ресурсів, але можна безпечно збирати хмиз і каміння."
                               FontSize="14" TextColor="#CCCCCC" />
                    </VerticalStackLayout>
                </Border>

                <!-- БЛОК ДІЙ ТА ФАРМУ -->
                <Border BackgroundColor="#252525" Stroke="#3A3A3A" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Збір ресурсів та полювання" FontSize="18" FontAttributes="Bold" TextColor="White" />

                        <!-- Індикатор прогресу дії -->
                        <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeShape="RoundRectangle 8" Padding="12">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" x:Name="FarmTimerLabel" Text="Очікування дії гравця..." FontSize="13" TextColor="#CCCCCC" />
                                    <Label Grid.Column="1" x:Name="FarmPercentLabel" Text="0%" FontSize="13" TextColor="#FFB74D" FontAttributes="Bold" />
                                </Grid>
                                <ProgressBar x:Name="FarmProgressBar" Progress="0" ProgressColor="#FFA726" HeightRequest="10" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Кнопка полювання (виклик бою) -->
                        <Button x:Name="HuntButton"
                                Text="⚔️ Вийти на полювання (Знайти ворога)"
                                BackgroundColor="#B71C1C" TextColor="White"
                                FontSize="15" FontAttributes="Bold" HeightRequest="46"
                                Clicked="OnHuntClicked" />

                        <!-- Варіант 1: Економна розвідка на удачу -->
                        <Button x:Name="MainFarmButton"
                                Text="🎲 Пофармитися на удачу (5 сек | -7⚡ -4🍖 -5💧)"
                                BackgroundColor="#E65100" TextColor="White"
                                FontSize="15" FontAttributes="Bold" HeightRequest="46"
                                Clicked="OnMainFarmClicked" />

                        <BoxView HeightRequest="1" Color="#3A3A3A" />

                        <!-- Варіант 2: Цільовий видобуток -->
                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="TargetedHeaderLabel"
                                   Text="Цільовий видобуток (10 сек | -15⚡ -8🍖 -9💧):"
                                   FontSize="13" TextColor="#AAAAAA" />

                            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                                <Button x:Name="BtnGatherWood" Grid.Row="0" Grid.Column="0"
                                        Text="🪓 Рубати дерева"
                                        BackgroundColor="#37474F" TextColor="White"
                                        Clicked="OnTargetedGatherClicked" CommandParameter="wood" />

                                <Button x:Name="BtnGatherStone" Grid.Row="0" Grid.Column="1"
                                        Text="⛏️ Добувати камінь/руду"
                                        BackgroundColor="#37474F" TextColor="White"
                                        Clicked="OnTargetedGatherClicked" CommandParameter="stone" />

                                <Button x:Name="BtnGatherFood" Grid.Row="1" Grid.Column="0"
                                        Text="🍓 Шукати їжу та воду"
                                        BackgroundColor="#37474F" TextColor="White"
                                        Clicked="OnTargetedGatherClicked" CommandParameter="food" />

                                <Button x:Name="BtnGatherLoot" Grid.Row="1" Grid.Column="1"
                                        Text="🔍 Шукати цінний лут"
                                        BackgroundColor="#455A64" TextColor="White"
                                        Clicked="OnTargetedGatherClicked" CommandParameter="loot" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Журнал дій -->
                <Border BackgroundColor="#121212" Stroke="#FFA726" StrokeShape="RoundRectangle 8" Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Результат взаємодії:" FontSize="13" TextColor="#FFB74D" FontAttributes="Bold" />
                        <Label x:Name="ExplorationLogLabel" Text="Оберіть розвідку, полювання або видобуток ресурсів..." FontSize="14" TextColor="#E0E0E0" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>