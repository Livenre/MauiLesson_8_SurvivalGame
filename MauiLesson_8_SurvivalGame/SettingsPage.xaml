<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiLesson_8_SurvivalGame.SettingsPage"
             Title="Налаштування"
             BackgroundColor="#181818">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Border BackgroundColor="#252525" Stroke="#3A3A3A" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="16">
                    <Label Text="⚙️ Налаштування гри" FontSize="18" FontAttributes="Bold" TextColor="White" />

                    <!-- Гучність -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="🔊 Гучність звуку та музики" TextColor="White" />
                            <Label Grid.Column="1" x:Name="VolumeValueLabel" Text="75%" TextColor="#81C784" />
                        </Grid>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="75"
                                MinimumTrackColor="#4CAF50" ValueChanged="OnVolumeChanged" />
                    </VerticalStackLayout>

                    <!-- Графіка -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🖥️ Якість графіки" TextColor="White" />
                        <Picker x:Name="GraphicsPicker" Title="Оберіть пресет графіки" TextColor="White" BackgroundColor="#1E1E1E" SelectedIndex="1">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Низька (Продуктивність)</x:String>
                                    <x:String>Середня (Збалансовано)</x:String>
                                    <x:String>Висока (Ультра)</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </VerticalStackLayout>

                    <Button Text="💾 Зберегти налаштування" BackgroundColor="#1976D2" TextColor="White"
                            Clicked="OnSaveSettingsClicked" />

                    <BoxView HeightRequest="1" Color="#3A3A3A" Margin="0,4" />

                    <!-- Кнопка скидання прогресу -->
                    <Label Text="Керування збереженням:" TextColor="#FF8A80" FontSize="14" FontAttributes="Bold" />
                    <Button Text="🔄 Скинути прогрес (Почати спочатку)"
                            BackgroundColor="#C62828" TextColor="White" FontAttributes="Bold"
                            Clicked="OnResetProgressClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Статус -->
            <Border BackgroundColor="#121212" Stroke="#1976D2" StrokeShape="RoundRectangle 8" Padding="12">
                <Label x:Name="SettingsStatusLabel" Text="Автозбереження гри увімкнено (локальний JSON)." FontSize="14" TextColor="#E0E0E0" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>