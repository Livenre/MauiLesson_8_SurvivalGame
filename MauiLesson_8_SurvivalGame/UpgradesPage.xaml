<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiLesson_8_SurvivalGame"
             x:Class="MauiLesson_8_SurvivalGame.UpgradesPage"
             Title="Крафт та Покращення"
             BackgroundColor="#181818">

    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,8" BackgroundColor="#181818">
            <local:PlayerHudView x:Name="HudView" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,20" Spacing="16">

                <!-- Зведення наявних матеріалів -->
                <Border BackgroundColor="#1E272C" Stroke="#4CAF50" StrokeShape="RoundRectangle 10" Padding="12">
                    <Label x:Name="ResourcesSummaryLabel"
                           Text="Ваші ресурси: 🪵 0 | 🪨 0 | ⛓️ 0 | 🧵 0 | 🥩 0"
                           FontSize="13" FontAttributes="Bold" TextColor="#81C784" />
                </Border>

                <!-- СЕКЦІЯ 1: КРАФТИНГ ПРЕДМЕТІВ -->
                <Border BackgroundColor="#252525" Stroke="#3A3A3A" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🔨 Крафтинг предметів та зброї" FontSize="18" FontAttributes="Bold" TextColor="#FFB74D" />

                        <!-- Дерев'яний спис -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="🗡️ Дерев'яний спис (Зброя +8 шкоди)" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Потрібно: 🪵 Деревина x5, 🪨 Камінь x2 (Верстак Рів. 1)" TextColor="#AAAAAA" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Скрафтити" BackgroundColor="#E65100" TextColor="White"
                                    Clicked="OnCraftSpearClicked" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#3A3A3A" />

                        <!-- Залізний мачете -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="⚔️ Залізний мачете (Зброя +18 шкоди)" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Потрібно: ⛓️ Залізна руда x4, 🪵 Деревина x3 (Верстак Рів. 2)" TextColor="#AAAAAA" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Скрафтити" BackgroundColor="#E65100" TextColor="White"
                                    Clicked="OnCraftMacheteClicked" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#3A3A3A" />

                        <!-- Смажене м'ясо -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="🍖 Смажене м'ясо (+45 ситості)" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Потрібно: 🥩 Сире м'ясо x1, 🪵 Деревина x1 (Вогнище)" TextColor="#AAAAAA" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Приготувати" BackgroundColor="#388E3C" TextColor="White"
                                    Clicked="OnCookMeatClicked" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#3A3A3A" />

                        <!-- Саморобний бинт -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="🩹 Саморобний бинт (+25 HP)" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Потрібно: 🧵 Тканина x2" TextColor="#AAAAAA" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Скрафтити" BackgroundColor="#1976D2" TextColor="White"
                                    Clicked="OnCraftBandageClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- СЕКЦІЯ 2: ПРОКАЧУВАННЯ БАЗИ ТА ХАРАКТЕРИСТИК -->
                <Border BackgroundColor="#252525" Stroke="#3A3A3A" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="📈 Прокачування бази та навичок" FontSize="18" FontAttributes="Bold" TextColor="#81C784" />

                        <!-- Верстак -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label x:Name="WorkbenchTitleLabel" Text="Верстак (Рівень 1)" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Відкриває доступ до залізної зброї. Потрібно: 🪵 x8, 🪨 x5" TextColor="#AAAAAA" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Покращити" BackgroundColor="#2E7D32" TextColor="White"
                                    Clicked="OnUpgradeWorkbenchClicked" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#3A3A3A" />

                        <!-- Рюкзак -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label x:Name="BackpackTitleLabel" Text="Місткість рюкзака (20 слотів)" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Потрібно: 🧵 Тканина x3, 🪵 Деревина x3 (+5 слотів)" TextColor="#AAAAAA" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Покращити" BackgroundColor="#2E7D32" TextColor="White"
                                    Clicked="OnUpgradeBackpackClicked" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#3A3A3A" />

                        <!-- Табір -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label x:Name="CampTitleLabel" Text="Укріплення табору (Рівень 1)" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Потрібно: 🪵 Деревина x8, ⛓️ Руда x2 (+20 Max HP)" TextColor="#AAAAAA" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Покращити" BackgroundColor="#2E7D32" TextColor="White"
                                    Clicked="OnUpgradeCampClicked" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#3A3A3A" />

                        <!-- Інструменти -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label x:Name="ToolsTitleLabel" Text="Інструменти виживальника (Рівень 1)" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Потрібно: ⛓️ Руда x2, 🪨 Камінь x3 (Прискорює фарм)" TextColor="#AAAAAA" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Покращити" BackgroundColor="#2E7D32" TextColor="White"
                                    Clicked="OnUpgradeToolsClicked" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#3A3A3A" />

                        <!-- Навичка: Сила -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label x:Name="StrengthTitleLabel" Text="Тренування сили (Рівень 1)" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Потрібно: 🥩 М'ясо x2, 🪵 Деревина x4 (+3 постійної шкоди)" TextColor="#AAAAAA" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Тренувати" BackgroundColor="#D84315" TextColor="White"
                                    Clicked="OnUpgradeStrengthClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Статус-лог -->
                <Border BackgroundColor="#121212" Stroke="#4CAF50" StrokeShape="RoundRectangle 8" Padding="12">
                    <Label x:Name="UpgradeLogLabel" Text="Оберіть предмет для крафту або покращення бази..." FontSize="14" TextColor="#E0E0E0" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>